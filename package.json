{
  "name": "@gravitee/ui-components",
  "version": "0.0.0",
  "description": "Gravitee.io UI Components library, based on Web Components",
  "repository": {
    "type": "git",
    "url": "https://github.com/gravitee-io/gravitee-ui-components"
  },
  "license": "Apache-2.0",
  "author": "",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "assets/css",
    "assets/i18n",
    "assets/icons",
    "assets/images",
    "src",
    "wc"
  ],
  "scripts": {
    "build": "yarn docs && yarn check:i18n && yarn generate:theme && yarn generate:dist && storybook build --quiet",
    "check:i18n": "node tasks/check-i18n.js",
    "compile": "tsc",
    "compile:watch": "tsc -w",
    "danger": "danger ci",
    "docs": "wca analyze src/** --outFile .docs/custom-elements.json && node tasks/generate-docs.js",
    "generate:dist": "yarn compile && cp -R assets dist/ && cp package.json dist/",
    "generate:icons": "node tasks/generate-icons.js && yarn lint:fix",
    "generate:theme": "zx tasks/generate-theme.mjs && yarn lint:fix",
    "lint": "eslint src testing tasks && yarn prettier",
    "lint:commit": "commitlint --from $(git describe --tags --abbrev=0) --to HEAD --verbose",
    "lint:fix": "eslint --fix src testing tasks && yarn prettier:fix",
    "lint:license": "license-check-and-add check -f license-check-config.json",
    "lint:license:fix": "license-check-and-add add -f license-check-config.json -r $(date +%Y)",
    "lint:package": "sort-package-json",
    "prepare": "is-ci || husky",
    "prettier": "prettier --check \"**/*.{ts,js,mjs,html,css,json}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,js,mjs,html,css,json}\"",
    "release": "semantic-release",
    "serve": "yarn docs && storybook dev -p 6006 --ci",
    "serve:prod": "yarn build && static -a 0.0.0.0 -p 8080 storybook-static",
    "test": "NODE_OPTIONS=--unhandled-rejections=warn jest",
    "test:coverage": "yarn test --collect-coverage",
    "test:watch": "yarn test --watchAll"
  },
  "lint-staged": {
    "*": "yarn lint:license:fix",
    "package.json": "yarn lint:package",
    "*.{js,mjs,html,css,json}": "prettier --write"
  },
  "resolutions": {
    "colors": "1.4.0"
  },
  "dependencies": {
    "@codemirror/basic-setup": "^0.19.1",
    "@codemirror/language-data": "^0.19.1",
    "@codemirror/stream-parser": "^0.19.9",
    "@formatjs/intl-locale": "^2.4.40",
    "@formatjs/intl-relativetimeformat": "^9.3.2",
    "@messageformat/core": "3.4.0",
    "@popperjs/core": "^2.11.7",
    "clipboard-copy": "^4.0.0",
    "codemirror-asciidoc": "^2.0.0",
    "date-fns": "^2.26.0",
    "dompurify": "3.4.15",
    "jdenticon": "^3.1.0",
    "jsonschema": "1.4.1",
    "lit": "3",
    "object-path": "^0.11.8",
    "resize-observer-polyfill": "^1.5.1",
    "whatwg-fetch": "^3.6.17"
  },
  "devDependencies": {
    "@asciidoctor/core": "3.0.2",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/plugin-transform-class-properties": "7.29.7",
    "@babel/plugin-transform-private-property-in-object": "7.29.7",
    "@babel/plugin-transform-typescript": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@highcharts/map-collection": "2.3.3",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/web-components-vite": "10.6.0",
    "asciidoctor": "3.0.2",
    "asciidoctor-highlight.js": "0.4.0",
    "babel-jest": "30.5.1",
    "chromatic": "18.7.4",
    "danger": "14.0.7",
    "del": "8.0.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-lit": "2.3.1",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.3.0",
    "fs-extra": "11.4.0",
    "github-markdown-css": "5.9.0",
    "glob": "13.0.6",
    "highcharts": "10.3.3",
    "highlight.js": "11.12.0",
    "html-to-react": "1.7.0",
    "husky": "9.1.7",
    "i18n-extract": "0.6.7",
    "is-ci": "4.1.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "license-check-and-add": "4.0.5",
    "lint-staged": "17.5.0",
    "markdown-it": "15.0.1",
    "marked": "15.0.12",
    "node-static": "0.7.11",
    "pascal-case": "4.0.0",
    "prettier": "3.8.5",
    "semantic-release": "25.0.9",
    "sort-package-json": "4.0.0",
    "storybook": "10.6.0",
    "svgo": "4.1.0",
    "svgstore": "3.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "web-component-analyzer": "1.1.6",
    "zx": "8.8.5"
  },
  "peerDependencies": {
    "@asciidoctor/core": "^3.0.2",
    "@highcharts/map-collection": "^1.0.0 || ^2.0.0",
    "asciidoctor": "^3.0.2",
    "asciidoctor-highlight.js": "^0.3.0 || ^0.4.0",
    "highcharts": "^8.0.0 || ^9.0.0 || ^10.0.0",
    "highlight.js": "^10.7.0 || ^11.1.0"
  },
  "peerDependenciesMeta": {
    "@asciidoctor/core": {
      "optional": true
    },
    "@highcharts/map-collection": {
      "optional": true
    },
    "asciidoctor": {
      "optional": true
    },
    "asciidoctor-highlight.js": {
      "optional": true
    },
    "highcharts": {
      "optional": true
    },
    "highlight.js": {
      "optional": true
    }
  },
  "packageManager": "yarn@3.4.1"
}
